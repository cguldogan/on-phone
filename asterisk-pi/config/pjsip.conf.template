; Only accept SIP from the tailnet (CGNAT 100.64/10) and localhost.
; Add "permit=192.168.0.0/16" here to also allow LAN phones.
[tailnet_only]
type=acl
deny=0.0.0.0/0.0.0.0
permit=100.64.0.0/10
permit=127.0.0.1/32

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060

; ---- shared phone template ----
[phone](!)
type=endpoint
context=internal
disallow=all
allow=opus,g722,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[auth](!)
type=auth
auth_type=userpass

[aor](!)
type=aor
max_contacts=3
remove_existing=yes
qualify_frequency=60
qualify_timeout=10   ; phones asleep or on a DERP relay can take seconds to answer OPTIONS

; ---- extensions ----
[1001](phone)
auth=1001
aors=1001
callerid="Ext 1001" <1001>
mailboxes=1001@default
[1001](auth)
username=1001
password=__PW_1001__
[1001](aor)

