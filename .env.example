# Copy to .env (or run scripts/gen-env.sh, which fills the secrets). Never commit .env.
ARI_URL=http://100.x.y.z:8088              # Asterisk ARI on the Pi, Tailscale IP only
ARI_USER=agentphone
ARI_PASSWORD=__generate__
MCP_BEARER_TOKEN=__generate__               # Claude Code reads it via ~/.config/agent-phone/token
MAC_TAILSCALE_IP=100.a.b.c                  # where Asterisk sends call audio (RTP 40000-40019/udp)
ALLOWED_DESTINATIONS=1001,1002,1099         # only these extensions can ever be called
CALLER_ID='"Coding Agent" <700>'
TTS_VOICE=af_heart
TTS_SPEED=0.9
MEDIA_CODEC=g722                            # g722 (wideband, default) | ulaw | slin16 (one-way on Asterisk 20.11)
LOG_LEVEL=INFO
# Optional
# RING_TIMEOUT_S=30
# IDLE_TIMEOUT_S=180
# MAX_CALL_S=900
# SESSION_TTL_MIN=240
# VAD_ENDPOINT_MS=900
# BARGEIN_MIN_SPEECH_MS=600
# ANSWER_SETTLE_MS=800
# ANSWER_GREETING_MAX_MS=3000
# DEBUG_AUDIO_DIR=/data/debug              # off by default; saves utterance WAV + transcript JSON
# DEBUG_RETENTION_HOURS=24
TEST_EXT_PASSWORD=__generate__              # SIP password of the 1099 test bot (acceptance tests)
